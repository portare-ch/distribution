"""Move emulator packages forward to their upstream HEAD.

Most of our emulator recipes pin a bare git commit - RetroArch, every
libretro core, and the standalone emulators that have no useful releases -
so keeping them current is a mechanical job: read the upstream default
branch, fetch the tarball that the new commit would produce, hash it, and
rewrite the two lines that say so. That is what this does.

It is deliberately narrow in three ways.

It only touches commit pins. A recipe pinned to a tag (armsx2 2.6.9,
scummvm 2026.3.0) is left alone, because moving a tag can cross a major
version and bring build-system changes with it - a decision for a person,
not a cron job. Non-GitHub sources are skipped for want of an API.

It never writes a checksum it did not compute. The new tarball is
downloaded and hashed here; if the download fails or the archive is
empty, that package is reported as skipped and left untouched rather
than being pinned to a checksum nobody verified.

And it is opt-out: put

    # bump-ignore: <reason>

anywhere in a package.mk to hold it where it is. The reason is printed in
the report, so a pin that is deliberately behind says why.

Usage:
    tools/bump-emulator-pins [--dry-run] [--only NAME ...] [--report FILE]
"""

import argparse
import hashlib
import json
import os
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

# Where emulator-ish recipes live. RetroArch and the shader/database
# packages sit under libretro/ alongside the cores, so this covers them.
ROOTS = [
    "projects/PortareOS/packages/emulators/libretro",
    "projects/PortareOS/packages/emulators/standalone",
    "projects/PortareOS/packages/compat",
]

SHA1 = re.compile(r"^[0-9a-f]{40}$")
UA = {"User-Agent": "portareos-bump-emulator-pins"}


def api(url):
    req = urllib.request.Request(url, headers=dict(UA))
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Accept", "application/vnd.github+json")
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def sha256_of(url):
    """Stream the tarball and hash it. Never holds the whole file in memory."""
    req = urllib.request.Request(url, headers=dict(UA))
    h = hashlib.sha256()
    size = 0
    with urllib.request.urlopen(req, timeout=600) as r:
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
            size += len(chunk)
    if size == 0:
        raise ValueError("downloaded 0 bytes")
    return h.hexdigest(), size


def one(text, key):
    """The single top-level assignment of `key`, or None if not exactly one.

    The trailing comment matters: retroarch writes

        PKG_VERSION="bdba046..." # v1.22.2 + fixes

    and an expression anchored straight to end-of-line silently fails to
    see it, which is how the first draft of this script quietly ignored
    RetroArch altogether.
    """
    hits = re.findall(rf'^{key}="([^"]*)"[^\S\n]*(?:#[^\n]*)?$', text, re.M)
    return hits[0] if len(hits) == 1 else None


def repin(text, key, old, new):
    """Replace one assignment's value, leaving any trailing comment alone."""
    pattern = rf'^({key}=")({re.escape(old)})("[^\S\n]*(?:#[^\n]*)?)$'
    out, n = re.subn(pattern, lambda m: m.group(1) + new + m.group(3),
                     text, count=1, flags=re.M)
    return out if n == 1 else None


def expand(url, name, site, version):
    for k, v in (("PKG_NAME", name), ("PKG_SITE", site), ("PKG_VERSION", version)):
        url = url.replace("${" + k + "}", v).replace("$" + k, v)
    return url


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true",
                    help="report what would change, write nothing")
    ap.add_argument("--only", nargs="*", metavar="NAME",
                    help="limit to these package directory names")
    ap.add_argument("--report", metavar="FILE",
                    help="write the markdown report here as well as stdout")
    args = ap.parse_args()

    bumped, skipped, current = [], [], 0

    pkgs = sorted(
        p for root in ROOTS for p in Path(root).glob("*/package.mk")
        if Path(root).is_dir()
    )

    for path in pkgs:
        name = path.parent.name
        if args.only and name not in args.only:
            continue
        text = path.read_text()

        m = re.search(r"^#\s*bump-ignore:\s*(.*)$", text, re.M)
        if m:
            skipped.append((name, f"held: {m.group(1).strip()}"))
            continue

        version = one(text, "PKG_VERSION")
        site = one(text, "PKG_SITE")
        url_t = one(text, "PKG_URL")
        have_sha = one(text, "PKG_SHA256")

        if version is None or site is None or url_t is None:
            # Say so rather than dropping it. A recipe this cannot read is
            # a recipe that silently stops being updated, which is worse
            # than one that is loudly left alone.
            skipped.append((name, "could not read PKG_VERSION/PKG_SITE/PKG_URL"))
            continue
        if not SHA1.match(version):
            skipped.append((name, f"pinned to a tag ({version}), left for a human"))
            continue
        if "github.com/" not in site:
            skipped.append((name, "not a GitHub source"))
            continue

        # A ".git" source is cloned at the commit rather than fetched as a
        # tarball, so there is no archive to hash and no PKG_SHA256 to
        # carry - the commit hash is the verification. Those packages need
        # the version line moved and nothing else.
        tarball = not url_t.endswith(".git")
        if tarball and have_sha is None:
            skipped.append((name, "tarball source with no single PKG_SHA256"))
            continue

        repo = site.split("github.com/", 1)[1].strip("/")
        try:
            info = api(f"https://api.github.com/repos/{repo}")
            head = api(f"https://api.github.com/repos/{repo}/commits/"
                       f"{info['default_branch']}")
            new = head["sha"]
        except (urllib.error.URLError, KeyError, json.JSONDecodeError) as e:
            skipped.append((name, f"upstream lookup failed: {e}"))
            continue

        if new == version:
            current += 1
            continue

        digest, size = None, 0
        if tarball:
            new_url = expand(url_t, name, site, new)
            try:
                digest, size = sha256_of(new_url)
            except Exception as e:                  # noqa: BLE001 - report, don't stop
                skipped.append((name, f"tarball not usable: {e}"))
                continue

        try:
            cmp_ = api(f"https://api.github.com/repos/{repo}/compare/{version}...{new}")
            ahead = cmp_.get("ahead_by", "?")
        except Exception:                           # noqa: BLE001 - cosmetic only
            ahead = "?"

        if not args.dry_run:
            out = repin(text, "PKG_VERSION", version, new)
            if out is not None and digest is not None:
                out = repin(out, "PKG_SHA256", have_sha, digest)
            if out is None:
                skipped.append((name, "could not rewrite the pin lines"))
                continue
            path.write_text(out)

        bumped.append({
            "name": name, "repo": repo, "old": version, "new": new,
            "ahead": ahead, "size": size, "kind": "tarball" if tarball else "git",
            "compare": f"https://github.com/{repo}/compare/{version[:12]}...{new[:12]}",
        })
        print(f"  {name}: {version[:12]} -> {new[:12]}  (+{ahead} commits)",
              file=sys.stderr)

    lines = []
    if bumped:
        lines.append("| package | upstream | commits | change |")
        lines.append("|---|---|---|---|")
        for b in bumped:
            lines.append(
                f"| `{b['name']}` | {b['repo']} | +{b['ahead']} | "
                f"[`{b['old'][:8]}` → `{b['new'][:8]}`]({b['compare']}) |")
    else:
        lines.append("No pin moved. Every commit-pinned package is already at "
                     "its upstream default branch.")

    lines.append("")
    lines.append(f"{current} already current, {len(bumped)} moved, "
                 f"{len(skipped)} skipped.")
    if skipped:
        lines.append("")
        lines.append("<details><summary>Skipped</summary>")
        lines.append("")
        for n, why in skipped:
            lines.append(f"- `{n}` — {why}")
        lines.append("")
        lines.append("</details>")

    report = "\n".join(lines) + "\n"
    print(report)
    if args.report:
        Path(args.report).write_text(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
