#
# Import upstream ROCKNIX package changes into this fork.
#
# Almost everything upstream does that we still want is a package change: a
# version bump, a new patch, a dropped patch that landed upstream of them too.
# Almost everything we have done that they must not undo is somewhere else -
# the project rename, the device tree, the branding, the removed hardware. So
# the useful unit of exchange is "their packages, onto our paths", and that is
# all this imports. It never touches distributions/, devices/, config/,
# scripts/, .github/ or documentation/.
#
# Three things make this more than a rebase:
#
#   * Paths differ. Their recipes live under projects/ROCKNIX/packages and ours
#     under projects/PortareOS/packages. The project directory names are read
#     from the two trees rather than hardcoded, so a later rename on either
#     side does not silently stop matching.
#
#   * We have deleted packages they still have. A rebase would resurrect every
#     one of them. Any file whose package directory is absent here is skipped
#     and reported, so removing a package stays removed.
#
#   * Content must NOT be rewritten. Their SPDX copyright headers and their
#     PKG_URL/PKG_SITE lines pointing at ROCKNIX-hosted sources are licence,
#     credit and dependency respectively - all of which we keep deliberately.
#     Files are imported verbatim. Where we have edited an in-content
#     identifier they also touched, that is a real conflict for a human, not
#     something to paper over with sed.
#
# Every file goes through a three-way merge against the last imported upstream
# commit, so a file we have not touched updates cleanly and one we have gets
# ordinary conflict markers. Nothing is committed: the result is left in the
# working tree to be reviewed.
#
# Usage:
#   tools/import-upstream-packages [options]
#
#     --from <ref>   upstream commit last imported
#                    (default: .upstream-sync, else the merge base)
#     --to <ref>     upstream commit to import   (default: upstream/next)
#     --upstream-project <name>
#                    their project directory, if it cannot be identified
#     --new          also import packages that do not exist here yet
#                    (off by default: adding a package is a decision, not an
#                    update, and it may pull in dependencies we do not carry)
#     --dry-run      report what would happen and change nothing
#     --finish       record the import after resolving conflicts by hand.
#                    Needed because a re-run works from the same base and so
#                    reproduces the same conflicts; this is how you say you
#                    have dealt with them. Refuses while markers remain.
#     -h, --help     this text

set -euo pipefail

SYNC_FILE=".upstream-sync"
TO_REF="upstream/next"
FROM_REF=""
WANT_NEW=0
DRY_RUN=0
THEIRS_PROJECT_OVERRIDE=""
FINISH=0

die() { printf 'error: %s\n' "$1" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --from) FROM_REF="${2:-}"; shift 2 ;;
    --to)   TO_REF="${2:-}"; shift 2 ;;
    --new)  WANT_NEW=1; shift ;;
    --upstream-project) THEIRS_PROJECT_OVERRIDE="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --finish) FINISH=1; shift ;;
    -h|--help) sed -n '3,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
UPSTREAM_URL="https://github.com/ROCKNIX/distribution.git"

# A fresh clone has no upstream remote at all, and telling someone in that
# position to fetch it just fails differently. Separate the two cases.
if ! git rev-parse --verify --quiet "${TO_REF}^{commit}" >/dev/null; then
  remote="${TO_REF%%/*}"
  if [ "${remote}" != "${TO_REF}" ] && ! git remote get-url "${remote}" >/dev/null 2>&1; then
    printf 'no "%s" remote in this clone. Add it with:\n\n' "${remote}" >&2
    printf '  git remote add %s %s\n  git fetch %s\n\n' \
      "${remote}" "${UPSTREAM_URL}" "${remote}" >&2
    die "no ${remote} remote"
  fi
  die "cannot resolve ${TO_REF} - try: git fetch ${TO_REF%%/*}"
fi

# Where the recipes live on each side. Read, not assumed, so a later rename on
# either side does not silently stop matching.
#
# Upstream carries ten project directories: ROCKNIX plus the nine LibreELEC
# hardware projects this fork removed. What singles ROCKNIX out is that it is
# the only name that is also a distribution - ARM, Rockchip and the rest are
# projects only, LEIoT and LibreELEC are distributions only. The same rule
# picks PortareOS here, so both sides use it.
project_dir() {
  local ref="$1" dirs
  dirs="$(LC_ALL=C comm -12 \
    <(git ls-tree -d --name-only "${ref}" projects/ 2>/dev/null | sed 's|^projects/||' | LC_ALL=C sort) \
    <(git ls-tree -d --name-only "${ref}" distributions/ 2>/dev/null | sed 's|^distributions/||' | LC_ALL=C sort))"
  [ "$(printf '%s\n' "${dirs}" | grep -c .)" = "1" ] \
    || die "cannot identify the project directory in ${ref} (found: ${dirs//$'\n'/ }) - pass --upstream-project"
  printf 'projects/%s\n' "${dirs}"
}

OURS_PROJECT="$(project_dir HEAD)"
if [ -n "${THEIRS_PROJECT_OVERRIDE}" ]; then
  THEIRS_PROJECT="projects/${THEIRS_PROJECT_OVERRIDE#projects/}"
else
  THEIRS_PROJECT="$(project_dir "${TO_REF}")"
fi

if [ -z "${FROM_REF}" ]; then
  if [ -r "${SYNC_FILE}" ]; then
    FROM_REF="$(awk 'NF && $1 !~ /^#/ {print $1; exit}' "${SYNC_FILE}")"
  else
    FROM_REF="$(git merge-base HEAD "${TO_REF}")"
    echo "no ${SYNC_FILE}: starting from the merge base ${FROM_REF:0:10}"
  fi
fi
git rev-parse --verify --quiet "${FROM_REF}^{commit}" >/dev/null \
  || die "cannot resolve --from ${FROM_REF}"

TO_SHA="$(git rev-parse "${TO_REF}")"
FROM_SHA="$(git rev-parse "${FROM_REF}")"

if [ "${FROM_SHA}" = "${TO_SHA}" ]; then
  echo "already at ${TO_SHA:0:10} - nothing to import."
  exit 0
fi

# Their path -> ours. Global packages/ is shared, so it maps to itself.
map_path() {
  case "$1" in
    "${THEIRS_PROJECT}/packages/"*) printf '%s\n' "${OURS_PROJECT}/${1#${THEIRS_PROJECT}/}" ;;
    packages/*)                     printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

# The nearest ancestor holding a package.mk is the package. Depth varies -
# emulators/libretro/dolphin-lr sits a level deeper than sysutils/btop - so
# this walks rather than counting slashes.
package_root() {
  local ref="$1" d
  d="$(dirname "$2")"
  while [ "${d}" != "." ] && [ "${d}" != "/" ]; do
    if git cat-file -e "${ref}:${d}/package.mk" 2>/dev/null; then
      printf '%s\n' "${d}"; return 0
    fi
    d="$(dirname "${d}")"
  done
  return 1
}

blob_exists() { git cat-file -e "$1:$2" 2>/dev/null; }
# A NUL in the first few KB. Written with tr rather than grep because bash
# cannot hold a NUL in a string, so the obvious grep pattern silently becomes
# the empty pattern and calls every file binary. pipefail is off inside: head
# closing the pipe early is normal here, not a failure.
is_binary() {
  local n
  n="$(set +o pipefail; git show "$1:$2" 2>/dev/null | head -c 8000 | tr -dc '\0' | wc -c)"
  [ "${n:-0}" -gt 0 ]
}

clean=() conflicted=() skipped_gone=() skipped_new=() removed=() manual=() modes=()

# Carry upstream's executable bit across. This repo already has a CI check for
# shebang scripts that lost it, because a script running at 100644 dies with
# "Permission denied" and exit code 126 rather than anything that names the
# cause - and cp onto an existing file keeps the old mode, so a merge would
# quietly leave it wrong.
sync_mode() {
  local mode
  mode="$(git ls-tree "${TO_SHA}" "$1" 2>/dev/null | awk '{print $1}')"
  case "${mode}" in
    100755) if [ ! -x "$2" ]; then chmod +x "$2"; modes+=("$2 +x"); fi ;;
    100644) if [ -x "$2" ]; then chmod -x "$2"; modes+=("$2 -x"); fi ;;
  esac
  return 0
}

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

merge_one() {
  local their_path="$1" our_path="$2" rc=0

  # Upstream deleted it. Only follow them if we had not diverged, otherwise the
  # deletion is a decision about our own change and belongs to a human.
  if ! blob_exists "${TO_SHA}" "${their_path}"; then
    # Already absent here - either we never had it, or a previous run of this
    # tool removed it. Re-running must not turn that into a complaint.
    [ -e "${our_path}" ] || return 0
    if [ "$(git hash-object "${our_path}")" = \
         "$(git rev-parse "${FROM_SHA}:${their_path}" 2>/dev/null || echo absent)" ]; then
      [ "${DRY_RUN}" = 1 ] || rm -f "${our_path}"
      removed+=("${our_path}")
    else
      manual+=("${our_path} (deleted upstream, modified here)")
    fi
    return 0
  fi

  # New upstream file inside a package we do carry: take it.
  if [ ! -e "${our_path}" ]; then
    if [ "${DRY_RUN}" = 0 ]; then
      mkdir -p "$(dirname "${our_path}")"
      git show "${TO_SHA}:${their_path}" > "${our_path}"
      sync_mode "${their_path}" "${our_path}"
    fi
    clean+=("${our_path}")
    return 0
  fi

  if is_binary "${TO_SHA}" "${their_path}"; then
    if [ "$(git hash-object "${our_path}")" = "$(git rev-parse "${FROM_SHA}:${their_path}" 2>/dev/null || echo none)" ]; then
      if [ "${DRY_RUN}" = 0 ]; then
        git show "${TO_SHA}:${their_path}" > "${our_path}"
        sync_mode "${their_path}" "${our_path}"
      fi
      clean+=("${our_path}")
    else
      manual+=("${our_path} (binary, changed on both sides)")
    fi
    return 0
  fi

  git show "${TO_SHA}:${their_path}" > "${tmp}/theirs"
  if blob_exists "${FROM_SHA}" "${their_path}"; then
    git show "${FROM_SHA}:${their_path}" > "${tmp}/base"
  else
    : > "${tmp}/base"
  fi
  cp "${our_path}" "${tmp}/ours"

  git merge-file -L "ours" -L "upstream ${FROM_SHA:0:10}" -L "upstream ${TO_SHA:0:10}" \
    "${tmp}/ours" "${tmp}/base" "${tmp}/theirs" >/dev/null 2>&1 || rc=$?

  if [ "${rc}" -lt 0 ] 2>/dev/null || [ "${rc}" -gt 127 ]; then
    manual+=("${our_path} (merge failed)")
    return 0
  fi

  if [ "${DRY_RUN}" = 0 ]; then
    cp "${tmp}/ours" "${our_path}"
    sync_mode "${their_path}" "${our_path}"
  fi
  if [ "${rc}" -gt 0 ]; then conflicted+=("${our_path}"); else clean+=("${our_path}"); fi
}

write_sync() {
  cat > "${SYNC_FILE}" <<EOF
# The upstream commit whose package changes have been imported into this fork.
# Written by tools/import-upstream-packages; the next import starts here.
${TO_SHA}
EOF
}

if [ "${FINISH}" = 1 ]; then
  left="$(grep -rl '^<<<<<<< ours' "${OURS_PROJECT}/packages" packages 2>/dev/null || true)"
  if [ -n "${left}" ]; then
    printf 'conflict markers are still in the tree:\n' >&2
    printf '  %s\n' ${left} >&2
    die "resolve them first"
  fi
  write_sync
  printf '%s -> %s\n' "${SYNC_FILE}" "${TO_SHA}"
  exit 0
fi

echo "importing package changes ${FROM_SHA:0:10}..${TO_SHA:0:10}"
echo "  ${THEIRS_PROJECT}/packages -> ${OURS_PROJECT}/packages"
echo

while IFS=$'\t' read -r status a b; do
  case "${status}" in
    R*) their_old="${a}"; their_path="${b}" ;;
    *)  their_old=""; their_path="${a}" ;;
  esac

  our_path="$(map_path "${their_path}" || true)"
  [ -n "${our_path}" ] || continue

  # A package we removed stays removed, whatever upstream does to it.
  if their_root="$(package_root "${TO_SHA}" "${their_path}" 2>/dev/null)"; then
    our_root="$(map_path "${their_root}" || true)"
    if [ -n "${our_root}" ] && [ ! -d "${our_root}" ]; then
      skipped_gone+=("${our_root#${OURS_PROJECT}/packages/}")
      continue
    fi
  elif [ ! -e "${our_path}" ] && [ "${WANT_NEW}" = 0 ]; then
    skipped_new+=("${our_path}")
    continue
  fi

  # Follow a rename before merging, so the file's history and our local edits
  # move with it instead of leaving a stale copy at the old path.
  if [ -n "${their_old}" ]; then
    our_old="$(map_path "${their_old}" || true)"
    if [ -n "${our_old}" ] && [ -e "${our_old}" ] && [ ! -e "${our_path}" ]; then
      if [ "${DRY_RUN}" = 0 ]; then
        mkdir -p "$(dirname "${our_path}")"
        git mv "${our_old}" "${our_path}" 2>/dev/null || mv "${our_old}" "${our_path}"
      fi
      echo "  renamed: ${our_old} -> ${our_path}"
    fi
  fi

  merge_one "${their_path}" "${our_path}"
done < <(git diff --name-status -M "${FROM_SHA}" "${TO_SHA}" -- \
           "${THEIRS_PROJECT}/packages" packages)

report() {
  local title="$1"; shift
  [ $# -eq 0 ] && return 0
  printf '\n%s (%d):\n' "${title}" "$#"
  printf '  %s\n' "$@"
}

printf '\n===== summary =====\n'
printf 'updated cleanly: %d\n' "${#clean[@]}"
printf 'conflicted:      %d\n' "${#conflicted[@]}"
printf 'removed:         %d\n' "${#removed[@]}"
gone_pkgs=0
[ ${#skipped_gone[@]} -gt 0 ] && \
  gone_pkgs="$(printf '%s\n' "${skipped_gone[@]}" | LC_ALL=C sort -u | grep -c .)"
printf 'skipped:         %d\n' "$(( gone_pkgs + ${#skipped_new[@]} ))"
printf 'needs a human:   %d\n' "${#manual[@]}"

report "conflicted - resolve the markers" ${conflicted[@]+"${conflicted[@]}"}
report "needs a human" ${manual[@]+"${manual[@]}"}
report "skipped, package removed from this fork" \
  $( [ ${#skipped_gone[@]} -gt 0 ] && printf '%s\n' "${skipped_gone[@]}" | sort -u )
report "skipped, new upstream package (use --new to take it)" ${skipped_new[@]+"${skipped_new[@]}"}
report "removed, following upstream" ${removed[@]+"${removed[@]}"}
report "file mode changed to match upstream" ${modes[@]+"${modes[@]}"}

if [ "${DRY_RUN}" = 1 ]; then
  printf '\ndry run: nothing changed.\n'
  exit 0
fi

if [ "${#conflicted[@]}" -gt 0 ] || [ "${#manual[@]}" -gt 0 ]; then
  printf '\n%s not written: resolve the above, then re-run or update it by hand.\n' "${SYNC_FILE}"
  exit 1
fi

write_sync
printf '\n%s -> %s\n' "${SYNC_FILE}" "${TO_SHA}"
printf 'review with: git diff\n'
