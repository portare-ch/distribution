# Source minimal predefined functions and variables
# to ensure as much performance as possible.
. /etc/profile.d/001-functions

VOLUME=$(get_setting "audio.volume")
MAX_VOLUME=100
MIN_VOLUME=0
STEP=5

case ${1} in
  "+"|"up")
    VOLUME=$(( ${VOLUME} + ${STEP} ))
  ;;
  "-"|"down")
    VOLUME=$(( ${VOLUME} - ${STEP} ))
  ;;
  "restore")
    true
  ;;
  *)
    VOLUME=${1}
  ;;
esac

if (( ${VOLUME} < ${MIN_VOLUME} ))
then
  VOLUME=${MIN_VOLUME}
elif (( ${VOLUME} > ${MAX_VOLUME} ))
then
  VOLUME=${MAX_VOLUME}
elif [ -z "${VOLUME}" ]
then
  VOLUME=50
fi

# wpctl takes a linear factor where pactl's % was cubic. EmulationStation
# applies the same cubic curve to its own slider, so a given percentage
# lands on the same volume whichever path set it.
LINEAR=$(awk -v v="${VOLUME}" 'BEGIN { printf "%.6f", (v/100)^3 }')
wpctl set-volume @DEFAULT_AUDIO_SINK@ "${LINEAR}"
set_setting "audio.volume" ${VOLUME}