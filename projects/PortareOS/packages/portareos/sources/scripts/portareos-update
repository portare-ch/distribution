. /etc/profile

# There is no update server. Put PortareOS-<device>.<arch>-<date>.tar in a
# directory called UPD, internally or on removable media, and this finds it.
#
# EmulationStation calls this, and expects:
#
#   check         exit 0 + print a version   -> ApiSystem::canUpdate()
#   check-media   exit 0, quietly            -> ApiSystem::canLocalUpdate()
#   update        stage it, printing ">>>NN%" for GuiUpdate's progress bar
#
# Staging only. ES prints "REBOOT TO APPLY" on exit 0.

# /flash is the FAT partition visible when the card is in a computer. The globs
# catch external media, which lands on a different path depending on what else
# is plugged in.
UPD_ROOTS="${UPD_ROOTS:-/storage/UPD /flash/UPD /storage/games-external/UPD /storage/games-internal/UPD /var/media/*/UPD /media/*/UPD}"

STAGE_DIR="${STAGE_DIR:-/storage/.update}"

# Print "<path> <version>" for the newest usable update, or nothing.
find_update() {
    best_file=""
    best_version=""
    running="${OS_VERSION}"
    force="$(get_setting updates.force)"

    for dir in ${UPD_ROOTS}; do
        [ -d "${dir}" ] || continue
        for f in "${dir}"/*.tar; do
            [ -f "${f}" ] || continue

            # A .tar for another device installs and leaves a handheld that
            # does not boot, so the name has to match before anything else.
            name="$(basename "${f}")"
            case "${name}" in
                *"${HW_DEVICE}"*"${HW_ARCH}"*) ;;
                *) continue ;;
            esac

            # Trailing -YYYYMMDD.tar. Dates sort correctly as strings, which
            # is the only reason a plain comparison is safe here.
            version="${name%.tar}"
            version="${version##*-}"
            case "${version}" in
                [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
                *) continue ;;
            esac

            # "Force next update" exists to override this.
            if [ "${force}" != "1" ] && [ "${version}" -le "${running}" ] 2>/dev/null; then
                continue
            fi

            if [ -z "${best_version}" ] || [ "${version}" -gt "${best_version}" ]; then
                best_version="${version}"
                best_file="${f}"
            fi
        done
    done

    [ -n "${best_file}" ] && echo "${best_file} ${best_version}"
}

# A missing .sha256 is not failure, so copying only the .tar still works, but
# say so rather than silently skipping the check.
verify_checksum() {
    file="$1"
    sum="${file}.sha256"

    if [ ! -f "${sum}" ]; then
        echo "No ${sum##*/} beside the update; skipping checksum verification."
        return 0
    fi

    expected="$(awk '{print $1}' "${sum}")"
    actual="$(sha256sum "${file}" | awk '{print $1}')"

    if [ "${expected}" = "${actual}" ]; then
        echo "Checksum verified."
        return 0
    fi

    echo "Checksum mismatch: ${file} does not match ${sum##*/}."
    return 1
}

stage_update() {
    found="$(find_update)"
    if [ -z "${found}" ]; then
        echo "No update available."
        return 1
    fi

    file="${found% *}"
    version="${found##* }"
    name="$(basename "${file}")"

    echo "Found ${name}"

    if ! verify_checksum "${file}"; then
        return 1
    fi

    size_mb=$(( $(stat -c %s "${file}") / 1048576 ))
    free_mb=$(df -m "${STAGE_DIR%/*}" | awk 'NR==2 {print $4}')
    need_mb=$(( size_mb + 512 ))   # the copy, plus room for the unpack
    if [ "${free_mb}" -lt "${need_mb}" ]; then
        echo "Not enough free space: need ${need_mb}MB, have ${free_mb}MB."
        return 1
    fi

    mkdir -p "${STAGE_DIR}" || { echo "Cannot create ${STAGE_DIR}."; return 1; }

    # Two staged tars means the bootloader picks one, possibly the old one.
    rm -f "${STAGE_DIR}"/*.tar "${STAGE_DIR}"/*.tar.sha256

    echo "Copying ${name} to ${STAGE_DIR} >>>0%"
    if ! cp "${file}" "${STAGE_DIR}/${name}.part"; then
        echo "Copy failed."
        rm -f "${STAGE_DIR}/${name}.part"
        return 1
    fi
    echo "Copying ${name} to ${STAGE_DIR} >>>90%"

    # Verify the copy, not just the source: a card pulled mid-copy is the case
    # this has to survive, and the bootloader applies what it finds without asking.
    if [ -f "${file}.sha256" ]; then
        cp "${file}.sha256" "${STAGE_DIR}/${name}.sha256"
        if ! verify_checksum "${STAGE_DIR}/${name}.part"; then
            echo "The staged copy is corrupt; discarding it."
            rm -f "${STAGE_DIR}/${name}.part" "${STAGE_DIR}/${name}.sha256"
            return 1
        fi
    elif [ "$(sha256sum "${file}" | awk '{print $1}')" != \
           "$(sha256sum "${STAGE_DIR}/${name}.part" | awk '{print $1}')" ]; then
        echo "The staged copy does not match the source; discarding it."
        rm -f "${STAGE_DIR}/${name}.part"
        return 1
    fi

    # Named last: an interrupted copy leaves a .part the bootloader ignores.
    mv "${STAGE_DIR}/${name}.part" "${STAGE_DIR}/${name}"
    sync

    set_setting updates.force 0
    echo "Update ${version} staged. >>>100%"
    echo "Reboot to apply."
    return 0
}

case "${1}" in
    check)
        found="$(find_update)"
        if [ -n "${found}" ]; then
            echo "${found##* }"
            exit 0
        fi
        echo "No update available."
        exit 1
        ;;
    check-media)
        [ -n "$(find_update)" ] && exit 0
        exit 1
        ;;
    update|"")
        stage_update
        exit $?
        ;;
    *)
        echo "Usage: ${0} [check|check-media|update]"
        echo "  check        print the version of an available update, or exit 1"
        echo "  check-media  exit 0 if an update is available, quietly"
        echo "  update       stage it in ${STAGE_DIR} for the next boot"
        exit 1
        ;;
esac
