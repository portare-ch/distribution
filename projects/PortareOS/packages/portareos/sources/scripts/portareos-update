. /etc/profile

# PortareOS has no update server, and is not getting one. Updates arrive as a
# file: put PortareOS-<device>.<arch>-<date>.tar in a directory called UPD,
# either on the internal filesystem or on removable media, and this finds it.
#
# The upstream version queried update.rocknix.org, which would have answered a
# PortareOS device with ROCKNIX images: a different distribution, whose boot
# partition label no longer matches, so the update would have installed and
# then not booted. All of that is gone rather than left switched off.
#
# EmulationStation drives this. The contract is narrow and worth stating:
#
#   check         exit 0 and print a version if an update is available.
#                 ApiSystem::canUpdate() runs this and shows the stdout in
#                 its "UPDATE AVAILABLE" prompt.
#   check-media   exit 0 if an update is available, quietly.
#                 ApiSystem::canLocalUpdate() gates its menu entry on this.
#   update        stage the update, printing ">>>NN%" lines that GuiUpdate
#                 parses into a progress bar.
#
# It does NOT reboot. ES shows "UPDATE IS READY / REBOOT TO APPLY" when this
# exits 0, and rebooting the device out from under it would be rude.

# Where a UPD directory may live. Internal first, then the boot partition
# (which is the FAT one visible when the card is in a computer), then whatever
# automount has mounted. Globs are deliberate: an external card can land on
# any of several paths depending on what else is plugged in.
UPD_ROOTS="${UPD_ROOTS:-/storage/UPD /flash/UPD /storage/games-external/UPD /storage/games-internal/UPD /var/media/*/UPD /media/*/UPD}"

STAGE_DIR="${STAGE_DIR:-/storage/.update}"

# Print "<path> <version>" for the newest usable update found, or nothing.
#
# "Usable" is doing real work here. A .tar built for another device installs
# and leaves a handheld that does not boot, so the filename has to name this
# device and this architecture before it is considered at all.
find_update() {
    best_file=""
    best_version=""
    running="${OS_VERSION}"
    force="$(get_setting updates.force)"

    for dir in ${UPD_ROOTS}; do
        [ -d "${dir}" ] || continue
        for f in "${dir}"/*.tar; do
            [ -f "${f}" ] || continue

            name="$(basename "${f}")"
            case "${name}" in
                *"${HW_DEVICE}"*"${HW_ARCH}"*) ;;
                *) continue ;;
            esac

            # Trailing -YYYYMMDD.tar. Dates sort correctly as strings, which
            # is the only reason a plain comparison is safe here.
            version="${name%.tar}"
            version="${version##*-}"
            case "${version}" in
                [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
                *) continue ;;
            esac

            # Offering what is already installed, or older, is how an update
            # menu becomes noise. "Force next update" overrides it, which is
            # what that switch is for.
            if [ "${force}" != "1" ] && [ "${version}" -le "${running}" ] 2>/dev/null; then
                continue
            fi

            if [ -z "${best_version}" ] || [ "${version}" -gt "${best_version}" ]; then
                best_version="${version}"
                best_file="${f}"
            fi
        done
    done

    [ -n "${best_file}" ] && echo "${best_file} ${best_version}"
}

# Verify against the .sha256 published beside the .tar, when it is there.
#
# Absence is not failure: someone who copied only the .tar should still be able
# to update. But it is said out loud, because the alternative is a silent
# downgrade of the one check that catches a truncated copy.
verify_checksum() {
    file="$1"
    sum="${file}.sha256"

    if [ ! -f "${sum}" ]; then
        echo "No ${sum##*/} beside the update; skipping checksum verification."
        return 0
    fi

    expected="$(awk '{print $1}' "${sum}")"
    actual="$(sha256sum "${file}" | awk '{print $1}')"

    if [ "${expected}" = "${actual}" ]; then
        echo "Checksum verified."
        return 0
    fi

    echo "Checksum mismatch: ${file} does not match ${sum##*/}."
    return 1
}

stage_update() {
    found="$(find_update)"
    if [ -z "${found}" ]; then
        echo "No update available."
        return 1
    fi

    file="${found% *}"
    version="${found##* }"
    name="$(basename "${file}")"

    echo "Found ${name}"

    if ! verify_checksum "${file}"; then
        return 1
    fi

    size_mb=$(( $(stat -c %s "${file}") / 1048576 ))
    free_mb=$(df -m "${STAGE_DIR%/*}" | awk 'NR==2 {print $4}')
    # The staged copy lives alongside the original until reboot, so the space
    # needed is the file again, plus room for the unpack the bootloader does.
    need_mb=$(( size_mb + 512 ))
    if [ "${free_mb}" -lt "${need_mb}" ]; then
        echo "Not enough free space: need ${need_mb}MB, have ${free_mb}MB."
        return 1
    fi

    mkdir -p "${STAGE_DIR}" || { echo "Cannot create ${STAGE_DIR}."; return 1; }

    # Anything already staged is superseded, and leaving two tars for the
    # bootloader to choose between is asking for the wrong one.
    rm -f "${STAGE_DIR}"/*.tar "${STAGE_DIR}"/*.tar.sha256

    echo "Copying ${name} to ${STAGE_DIR} >>>0%"
    if ! cp "${file}" "${STAGE_DIR}/${name}.part"; then
        echo "Copy failed."
        rm -f "${STAGE_DIR}/${name}.part"
        return 1
    fi
    echo "Copying ${name} to ${STAGE_DIR} >>>90%"

    # Verify the copy, not just the source. A card pulled mid-copy is exactly
    # the case this whole flow has to survive, and the bootloader applies
    # whatever it finds here without asking.
    if [ -f "${file}.sha256" ]; then
        cp "${file}.sha256" "${STAGE_DIR}/${name}.sha256"
        if ! verify_checksum "${STAGE_DIR}/${name}.part"; then
            echo "The staged copy is corrupt; discarding it."
            rm -f "${STAGE_DIR}/${name}.part" "${STAGE_DIR}/${name}.sha256"
            return 1
        fi
    elif [ "$(sha256sum "${file}" | awk '{print $1}')" != \
           "$(sha256sum "${STAGE_DIR}/${name}.part" | awk '{print $1}')" ]; then
        echo "The staged copy does not match the source; discarding it."
        rm -f "${STAGE_DIR}/${name}.part"
        return 1
    fi

    # Named last, so a copy interrupted at any point leaves a .part the
    # bootloader ignores rather than a half-written .tar it would try to apply.
    mv "${STAGE_DIR}/${name}.part" "${STAGE_DIR}/${name}"
    sync

    set_setting updates.force 0
    echo "Update ${version} staged. >>>100%"
    echo "Reboot to apply."
    return 0
}

case "${1}" in
    check)
        found="$(find_update)"
        if [ -n "${found}" ]; then
            echo "${found##* }"
            exit 0
        fi
        echo "No update available."
        exit 1
        ;;
    check-media)
        [ -n "$(find_update)" ] && exit 0
        exit 1
        ;;
    update|"")
        stage_update
        exit $?
        ;;
    *)
        echo "Usage: ${0} [check|check-media|update]"
        echo "  check        print the version of an available update, or exit 1"
        echo "  check-media  exit 0 if an update is available, quietly"
        echo "  update       stage it in ${STAGE_DIR} for the next boot"
        exit 1
        ;;
esac
