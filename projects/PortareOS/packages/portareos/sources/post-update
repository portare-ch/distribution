. /etc/profile

LOG="/var/log/boot.log"

### This script contains items that we only want to execute after a PortareOS upgrade,
### or after a fresh installation.

### Items in this block should always run after updates.
################################################################################

echo "Rebuild library cache..." >>${LOG}
tocon "Rebuilding library cache..."
### Rebuild the library cache
rm -f /storage/.cache/ld.so.cache
ldconfig -X

echo "Sync configuration files..." >>${LOG}
tocon "Re-sync configuration files..."
### Sync configurations
if [ -d "/storage/.config/system/configs" ]
then
  EXCLUDE="--exclude=configs"
fi

### Remove and link es configs so they are managed with OS updates.
for es_cfg in es_features.cfg es_systems.cfg
do
  mv /storage/.config/emulationstation/${es_cfg} /storage/.config/emulationstation/last_${es_cfg} >/dev/null 2>&1
  ln -s /usr/config/emulationstation/${es_cfg} /storage/.config/emulationstation/${es_cfg}  >/dev/null 2>&1
done

rsync -a --delete ${EXCLUDE} /usr/config/system/ /storage/.config/system/
rsync -a --ignore-existing /usr/config/game /storage/.config/
rsync -a /usr/config/modules /storage/.config/

### Config files that are new in this image. userconfig-setup does this once,
### guarded by /storage/.configured, so without a pass here a file added to
### /usr/config never reaches a device that has already booted.
###
### --ignore-existing, so this delivers files that are new and never touches
### one the user has edited. Changed *contents* of an existing file still need
### a migration at the bottom of this script. system/ is excluded because the
### block above already syncs it deliberately, and the es configs because they
### are symlinks into /usr/config.
rsync -a --ignore-existing --exclude=system \
      --exclude={es_features.cfg,es_systems.cfg} \
      /usr/config/* /storage/.config/ >>${LOG} 2>&1

if [ -f "/storage/.config/emulationstation/resources/logo.png" ]
then
  rm -f /storage/.config/emulationstation/resources/logo.png
fi

echo "Sync modules..." >>${LOG}
tocon "Update tool modules..."
rsync -a /usr/config/modules/* /storage/.config/modules/
cp -f /usr/config/retroarch/retroarch-core-options.cfg /storage/.config/retroarch/retroarch-core-options.cfg

### Apply developer ssh keys if they exist
echo "Apply dev keys if available..." >>${LOG}
if [ -e /usr/config/ssh/authorized_keys ]
then
  tocon "Update developer keys..."
  cp /usr/config/ssh/authorized_keys /storage/.ssh
fi

### Apply developer wifi config if they exist
echo "Apply dev wifi config if available..." >>${LOG}
if [ -d /usr/config/iwd ]
then
  tocon "Update developer wifi config..."
  cp /usr/config/iwd/* /storage/.cache/iwd/
fi

### Add cloud sync-related files if missing
echo "Update cloud sync files..." >>${LOG}
if [ -x "/usr/bin/cloud_sync_helper" ]; then
  # Use the helper script to properly merge configurations
  tocon "Updating cloud sync configuration..."
  /usr/bin/cloud_sync_helper ${LOG}
else
  # Fall back to the simple copy if helper is not available
  tocon "Updating cloud sync files..."
  # Copy default cloud sync files if they don't exist
  for config_file in cloud_sync-rules.txt.defaults cloud_sync.conf.defaults; do
    if [ -f "/usr/config/${config_file}" ]; then
      rsync --ignore-existing /usr/config/${config_file} /storage/.config/
    fi
  done
  # Also copy the main config file if it doesn't exist
  if [ -f "/usr/config/cloud_sync.conf" ]; then
    rsync --ignore-existing /usr/config/cloud_sync.conf /storage/.config/
    # Always update defaults file to ensure latest version
    rsync /usr/config/cloud_sync.conf.defaults /storage/.config/
  fi
fi

### Sync locale data
tocon "Re-sync locale data..."
rsync -a --delete /usr/config/locale/* /storage/.config/locale/ >>/var/log/configure.log 2>&1
rm -rf /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:
ln -sf /usr/share/locale /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:

### Handle assets folder for ppsspp v1.20+ upgrade
if [ ! -d "/storage/.config/ppsspp/assets/ui_images" ]
then
  rsync -a --delete /usr/config/ppsspp/assets/* /storage/.config/ppsspp/assets/
fi

### Fix Japanese language bug
if [ ! -e "/storage/.config/ppsspp/assets/NotoSansJP-Regular.ttf" ]
then
  cd /storage/.config/ppsspp/assets
  cp /usr/config/ppsspp/assets/NotoSansJP-Regular.ttf .
  ln -s NotoSansJP-Regular.ttf Roboto-Condensed.ttf
  cd -
fi

### Add items below this line that are safe to remove after a period of time.
################################################################################

# Copy aethersx2 bios files for armsx2 for convenience
if [ -d "/storage/roms/bios/aethersx2/bios" ] && [ ! -d "/storage/roms/bios/armsx2" ]; then
  cp -rf /storage/roms/bios/aethersx2/bios /storage/roms/bios/armsx2
fi

# Set the flag to enable batteryplus capacity reporting if it doesn't already exist
grep -q "^system\.batteryplus\.enabled=" /storage/.config/system/configs/system.cfg ||
    sed -i '$ a\system.batteryplus.enabled=1' /storage/.config/system/configs/system.cfg

# Dolphin controller profiles moved from evdev to SDL bindings. Existing copies
# in /storage name "Microsoft X-Box 360 pad", the virtual pad gptokeyb used to
# create, and Dolphin no longer starts gptokeyb, so they would bind nothing.
# The launch scripts only seed these when absent, so refresh them here.
DOLPHIN_CFG="/storage/.config/dolphin-emu"
# Checked against the shipped profiles only, never the backups written below.
# Those profiles have since been renamed, so the rsync no longer overwrites the
# names tested here; the cleanup below is what keeps this from firing twice.
if grep -qs "Microsoft X-Box 360 pad" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
     "${DOLPHIN_CFG}/Hotkeys.ini"; then
  tocon "Updating Dolphin controller profiles for SDL..."
  # A custom profile cannot be carried over, so keep a copy before replacing it.
  if [ -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" ]; then
    mv -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" \
          "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom.evdev"
  fi
  if [ -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" ]; then
    mv -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" \
          "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini.evdev"
  fi
  rsync -a /usr/config/dolphin-emu/Hotkeys.ini \
           /usr/config/dolphin-emu/GamecubeControllerProfiles \
           /usr/config/dolphin-emu/WiiControllerProfiles "${DOLPHIN_CFG}/"
  # Regenerated from the profiles above on the next launch.
  rm -f "${DOLPHIN_CFG}/GCPadNew.ini" "${DOLPHIN_CFG}/WiimoteNew.ini"
fi

# The GC profiles gained stacked/inline shoulder variants and are now named for
# the layout they target, so the old single-layout files are dead. They must go:
# the SDL migration above tests them by name, and nothing overwrites them any
# more, so leaving them behind re-fires that block on every later update and
# overwrites the .evdev backup it took the first time.
rm -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
      "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south"

# portareos-fake-suspend is gone (the Nova suspends for real), and with it
# its settings.
for KEY in system.suspend.enable system.suspend.enable_timed_shutdown \
           system.suspend.park_cores system.suspend.dpms \
           system.shutdown_delay system.shutdown_delay_running_game; do
  sed -i "/^${KEY}=/d" /storage/.config/system/configs/system.cfg
done

### One-shot migrations
################################################################################
#
# For defaults that changed inside a file an existing install already has, so
# neither userconfig-setup nor the --ignore-existing pass above can deliver
# them. Each runs once and leaves a marker, so a later deliberate choice by the
# user is not undone by the next update.

MIGRATIONS="/storage/.config/system/.migrations"
mkdir -p "${MIGRATIONS}"

migrate() {
  local name="${1}"
  shift

  [ -e "${MIGRATIONS}/${name}" ] && return 0

  echo "Migration: ${name}" >>${LOG}
  "$@" >>${LOG} 2>&1
  touch "${MIGRATIONS}/${name}"
}

# ondemand was never chosen: 008-perfmode picked it automatically for any
# device that offered it, and only ever sets the value when it is unset. On
# this part it parked the little cluster at 2016000 kHz while idle, where
# schedutil sits at 556800. Anything the user has since set on purpose is left
# alone, since only ondemand is moved.
migrate_cpugovernor() {
  [ "$(get_setting system.cpugovernor)" = "ondemand" ] || return 0
  grep -qw schedutil \
    /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null || return 0

  set_setting system.cpugovernor schedutil
}

# FpsLimit ships as a default in es_settings.cfg, and an existing install
# already has that file. Read the value out of the image rather than repeating
# it here, and only insert when the key is absent.
migrate_es_fpslimit() {
  local cfg="/storage/.config/emulationstation/es_settings.cfg"
  local shipped="/usr/config/emulationstation/es_settings.cfg"
  local value

  [ -f "${cfg}" ] || return 0
  grep -q 'name="FpsLimit"' "${cfg}" && return 0

  value=$(sed -n 's/.*name="FpsLimit" value="\([0-9]*\)".*/\1/p' "${shipped}" 2>/dev/null)
  [ -n "${value}" ] || return 0

  sed -i "s|</config>|    <int name=\"FpsLimit\" value=\"${value}\" />\n</config>|" "${cfg}"
}

migrate cpugovernor-schedutil migrate_cpugovernor
migrate es-fpslimit migrate_es_fpslimit
