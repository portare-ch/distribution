# What tools/import-upstream-packages never imports, one per line: a package
# name, or a single file by its upstream path below packages/. For recipes
# this fork has rewritten far enough that upstream's version would be a
# regression rather than an update, and for files this fork has removed.

# Kernel: our config, the kernel_options assertion and the sched_ext work
# live here. Version bumps are taken by hand.
linux

# The state machine for devices without working suspend. Removed; the Nova
# suspends for real and its power key is owned by the SM8550 power-handler.
rocknix/sources/scripts/rocknix-fake-suspend

# Amiga core we do not use; puae covers it. Removed.
uae4arm-lr

# EOL PS2 appimage. armsx2 is the only PS2 emulator this fork ships.
# Removed.
aethersx2-sa

# Wii U emulator with no usable 4:3 mode on a 4:3 panel. Removed, and
# the wiiu system with it.
cemu-sa

# A closed-source Nintendo DS binary, a 32-bit-only N64 emulator we never
# built, and a Jaguar emulator behind retroarch's own. All removed.
drastic-sa
daedalusx64-sa
bigpemu-sa

# An iOS app emulator, and the only thing that pulled sndio in. Both removed.
touchhle-sa
sndio

# Alternatives nobody defaulted to, all still covered by the retroarch core
# that was already the default. skyemu also remains as skyemu-lr.
skyemu-sa
nanoboyadvance-sa
hatarisa

# PS Vita is 960x544, exactly 16:9, so it letterboxes on this panel the way
# psp does. Removed with its system.
vita3k-sa

# Only emulationstation ever linked it, and that is libmpv now. Removed.
vlc

# SDL2 is sdl2-compat here: the SDL2 API on top of SDL3, so SDL2 clients
# get SDL3's backends and, with them, wp_tearing_control. Upstream's
# recipe builds real SDL2 and would undo that, patches and all.
SDL2

# Systems this fork does not keep. The device is used for a fixed list -
# PSX, PS2, PS3, SNES, N64, GameCube/Wii, Xbox, arcade/MAME, Game Boy
# through GBA, PSP, ScummVM, Steam, Dreamcast, Genesis and PortMaster -
# and everything below served only the systems that went with them.
# Removed, so upstream's recipes must not come back.

